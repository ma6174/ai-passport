// main/local_secrets.h.example
// 首次烧录时把本文件复制成 `main/local_secrets.h`(已被 .gitignore 忽略)并填真值。
// 固件第一次启动会把缺失字段写进 NVS;之后改配置不需要重新编译。
#pragma once

#define SONAR_SEED_WIFI_SSID "你的 Wi-Fi 名称"
#define SONAR_SEED_WIFI_PASS "你的 Wi-Fi 密码"
// Sonar 服务地址(无末尾斜杠),例如 https://122.195.131.106
#define SONAR_SEED_BASE_URL "http://122.195.131.106"
// 本机在服务端对应的设备 Token(server/.env 里的 SONAR_BOB_TOKEN 或 SONAR_ALICE_TOKEN)
#define SONAR_SEED_TOKEN "REPLACE_WITH_DEVICE_TOKEN"
// 1 = 松手后直接发布;0 = 需要再按一次 OK 确认
#define SONAR_SEED_AUTO_PUBLISH 0
// 0 = 模拟现场(只匹配中环线金科路口的模拟问题,无需服务端开关)
// 语音会话固定发问的目标点位(与作者所在地分开),留空则用定位解析出的收藏点位
// 模力社区 = B0K2KHYN77;人工智能岛 = B0FFJEOSPR;七牛 = B0FFJSBSGR
#define SONAR_SEED_REMOTE_PLACE "B0K2KHYN77"
// 1 = 模拟定位(上报三个高德 POI 的坐标;服务端需要 SONAR_ALLOW_MOCK_LOCATION=true)
#define SONAR_SEED_PRESENCE_MODE 1
