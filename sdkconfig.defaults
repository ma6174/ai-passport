# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=16

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# --- 声呐客户端:网络与内存(BT 关闭,把内部 RAM 留给 TLS/音频) ---
CONFIG_BT_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Wi-Fi 缓冲数量:本机只跑一个小 HTTP 轮询 + 一路 32 KB/s 上行音频,
# 默认 10×静态 RX / 32×动态 RX 会在无 PSRAM 的 C3 上占掉十几 KB,
# 让 TLS 握手(需要一块 5 KB 以上的连续内存)在高负载时刻失败。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# TLS:两个并发连接(WSS + Sonar HTTPS)在无 PSRAM 的 C3 上必须收窄 frag 长度。
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=5120
# 按需增删 TLS 缓冲:WSS + HTTPS 并发时降低峰值占用
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# Flash 写入(录音落 SPIFFS)会关 cache 并延迟默认 I2S 中断,ISR 必须 IRAM 安全。
CONFIG_I2S_ISR_IRAM_SAFE=y

# SPIFFS 存储分区。
CONFIG_SPIFFS_MAX_PARTITIONS=2

# 临时:排障用 mbedTLS 握手日志(定位证书校验 flag)
# CONFIG_MBEDTLS_DEBUG is not set
CONFIG_MBEDTLS_DEBUG_LEVEL=4
CONFIG_MBEDTLS_DEBUG_LEVEL=4
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
